# =============================================================================
# Tomato Leaf Disease Detection with Attention Networks — .gitignore
# =============================================================================
# Rule of thumb: generated artifacts, datasets, environments and caches stay out
# of Git. Source code, configs/config.yaml, tests/, notebooks/, README.md and
# requirements.txt are intentionally TRACKED (do not add them here).
# =============================================================================

# --- Virtual environments ----------------------------------------------------
/venv/
.venv/
/env/
/ENV/

# --- Dataset (supplied manually by the user; never committed) ----------------
/data/

# --- Model checkpoints / training artifacts ----------------------------------
# best_model_*.pt are committed so HF Spaces can load the models at runtime.
# Smoke-test and last_model checkpoints are excluded (large, not needed for inference).
/checkpoints/smoke/
/checkpoints/last_model_*.pt

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
/build/
/dist/
*.manifest

# --- Testing / typing / linting caches ---------------------------------------
.pytest_cache/
# Local console logs (pytest/live-run captures; never contain dataset data).
logs/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb.tmp

# --- Generated results (metrics, figures, Grad-CAM output) -------------------
/results/
/runs/
*.log

# --- Common OS temporary files ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Common editor temporary files ------------------------------------------
.idea/
.history/
*~
*.swp
*.swo
*.bak
*.tmp
*.orig

/tools/
